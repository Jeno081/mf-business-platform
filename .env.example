# Environnement de développement
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# MySQL Clever Cloud — remplacer par l'URI fournie par Clever Cloud
DATABASE_URL="mysql://user:password@host:3306/mf_business"

# Origines autorisées (frontend + admin)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# JWT (sera utilisé à l'étape authentification)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
