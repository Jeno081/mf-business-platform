{
  "name": "@mf/api",
  "version": "0.1.0",
  "private": true,
  "description": "API e-commerce MF Business — Express, Prisma, Socket.io",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --watch dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsc -p tsconfig.json && node dist/scripts/create-admin.js"
  },
  "dependencies": {
    "@mf/database": "workspace:*",
    "@mf/types": "workspace:*",
    "@prisma/client": "6.16.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "otplib": "^12.0.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.0"
  }
}
