generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identité & sécurité
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  SUPPORT
  STOCK
  MANAGER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique @db.VarChar(191)
  phone           String?    @unique @db.VarChar(32)
  passwordHash    String?    @db.VarChar(255)
  firstName       String?    @db.VarChar(100)
  lastName        String?    @db.VarChar(100)
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  twoFactorSecret String?    @db.VarChar(191)
  twoFactorEnabled Boolean   @default(false)
  twoFactorRecoveryCodes Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  addresses             Address[]
  refreshTokens         RefreshToken[]
  passwordResets        PasswordReset[]
  verificationTokens    VerificationToken[]
  otpCodes              OtpCode[]
  carts                 Cart[]
  orders                Order[]                @relation("UserOrders")
  orderStatusChanges    OrderStatusHistory[]   @relation("OrderStatusChangedBy")
  reviews               ProductReview[]
  wishlists             Wishlist[]
  couponRedemptions     CouponRedemption[]
  conversations         Conversation[]         @relation("CustomerConversations")
  assignedConversations Conversation[]         @relation("AssignedAdminConversations")
  messages              Message[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  pushSubscriptions     PushSubscription[]
  inventoryMovements    InventoryMovement[]
  purchaseOrders        PurchaseOrder[]
  auditLogs             AuditLog[]

  @@index([role, status])
  @@index([createdAt])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  label        String? @db.VarChar(60)
  recipient    String  @db.VarChar(160)
  phone        String  @db.VarChar(32)
  province     String? @db.VarChar(100)
  city         String  @db.VarChar(100)
  commune      String? @db.VarChar(100)
  addressLine  String  @db.VarChar(255)
  reference    String? @db.VarChar(255)
  isDefault    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, isDefault])
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique @db.VarChar(255)
  familyId    String    @db.VarChar(64)
  userAgent   String?   @db.VarChar(255)
  ipAddress   String?   @db.VarChar(64)
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?   @db.VarChar(191)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  type      String    @db.VarChar(40)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  phone     String    @db.VarChar(32)
  codeHash  String    @db.VarChar(255)
  purpose   String    @db.VarChar(40)
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(120)
  slug      String   @unique @db.VarChar(191)
  logoUrl   String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(191)
  description String?  @db.Text
  imageUrl    String?  @db.VarChar(500)
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, position])
}

model Product {
  id               String        @id @default(cuid())
  name             String        @db.VarChar(191)
  slug             String        @unique @db.VarChar(191)
  sku              String?       @unique @db.VarChar(80)
  subtitle         String?       @db.VarChar(191)
  series           String?       @db.VarChar(120)
  badge            String?       @db.VarChar(60)
  badgeTone        String?       @db.VarChar(40)
  shortDescription String?       @db.VarChar(500)
  description      String?       @db.Text
  keywords         String?       @db.Text
  price            Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  currency         String        @default("USD") @db.VarChar(3)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  ratingAverage    Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount      Int           @default(0)
  metaTitle        String?       @db.VarChar(191)
  metaDescription  String?       @db.VarChar(320)
  brandId          String
  categoryId       String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  brand        Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     ProductVariant[]
  images       ProductImage[]
  specs        ProductSpec[]
  features     ProductFeature[]
  reviews      ProductReview[]
  orderItems   OrderItem[]

  @@index([brandId, status])
  @@index([categoryId, status])
  @@index([isFeatured, status])
  @@index([createdAt])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String   @unique @db.VarChar(80)
  name          String   @db.VarChar(160)
  storage       String?  @db.VarChar(60)
  color         String?  @db.VarChar(80)
  priceOverride Decimal? @db.Decimal(12, 2)
  stockQuantity Int      @default(0)
  weightGrams   Int?
  barcode       String?  @db.VarChar(80)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  images             ProductImage[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  wishlistItems      WishlistItem[]

  @@index([productId, isActive])
  @@index([stockQuantity])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  url       String   @db.VarChar(500)
  publicId  String?  @db.VarChar(191)
  alt       String?  @db.VarChar(191)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
}

model ProductSpec {
  id        String @id @default(cuid())
  productId String
  label     String @db.VarChar(100)
  value     String @db.VarChar(255)
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductFeature {
  id        String @id @default(cuid())
  productId String
  text      String @db.VarChar(255)
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductReview {
  id        String       @id @default(cuid())
  productId String
  userId    String
  orderId   String?
  rating    Int
  title     String?      @db.VarChar(160)
  body      String?      @db.Text
  images    Json?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([productId, userId, orderId])
  @@index([productId, status])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Mes favoris") @db.VarChar(80)
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  variantId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, variantId])
}

// ---------------------------------------------------------------------------
// Panier, commandes, paiements & livraison
// ---------------------------------------------------------------------------

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  MOBILE_MONEY
  CARD
}

enum PaymentProvider {
  CASH_ON_DELIVERY
  MPESA
  AIRTEL_MONEY
  ORANGE_MONEY
  STRIPE
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?
  guestToken String?    @unique @db.VarChar(191)
  status     CartStatus @default(ACTIVE)
  currency   String     @default("USD") @db.VarChar(3)
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId, status])
  @@index([status, expiresAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique @db.VarChar(40)
  idempotencyKey   String?       @unique @db.VarChar(191)
  userId           String?
  addressId        String?
  customerName     String        @db.VarChar(160)
  customerPhone    String        @db.VarChar(32)
  customerEmail    String?       @db.VarChar(191)
  shippingAddress  Json?
  subtotal         Decimal       @db.Decimal(12, 2)
  discountTotal    Decimal       @default(0) @db.Decimal(12, 2)
  deliveryFee      Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  currency         String        @default("USD") @db.VarChar(3)
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentMethod    PaymentMethod @default(CASH_ON_DELIVERY)
  notes            String?       @db.Text
  placedAt         DateTime      @default(now())
  confirmedAt      DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user               User?                @relation("UserOrders", fields: [userId], references: [id], onDelete: SetNull)
  address            Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payments           Payment[]
  shipments          Shipment[]
  couponRedemptions  CouponRedemption[]
  reviews            ProductReview[]
  conversations      Conversation[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([placedAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  variantId      String?
  productName    String  @db.VarChar(191)
  variantLabel   String? @db.VarChar(160)
  sku            String? @db.VarChar(80)
  unitPrice      Decimal @db.Decimal(12, 2)
  quantity       Int
  lineTotal      Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  changedById String?
  note        String?     @db.VarChar(500)
  createdAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider @default(CASH_ON_DELIVERY)
  method            PaymentMethod   @default(CASH_ON_DELIVERY)
  providerReference String?         @db.VarChar(191)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("USD") @db.VarChar(3)
  status            PaymentStatus   @default(PENDING)
  rawPayload        Json?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([provider, providerReference])
  @@index([orderId, status])
  @@index([createdAt])
}

model PaymentEvent {
  id                String          @id @default(cuid())
  provider          PaymentProvider
  eventId           String          @db.VarChar(191)
  orderId           String?
  signatureVerified Boolean         @default(false)
  payload           Json
  processedAt       DateTime?
  createdAt         DateTime        @default(now())

  @@unique([provider, eventId])
  @@index([orderId])
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Refund {
  id          String       @id @default(cuid())
  paymentId   String
  amount      Decimal      @db.Decimal(12, 2)
  reason      String?      @db.VarChar(500)
  status      RefundStatus @default(PENDING)
  providerRef String?      @db.VarChar(191)
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, status])
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  carrier        String?        @db.VarChar(120)
  trackingNumber String?        @db.VarChar(120)
  status         ShipmentStatus @default(PENDING)
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model DeliveryZone {
  id                 String   @id @default(cuid())
  name               String   @db.VarChar(120)
  city               String   @db.VarChar(120)
  fee                Decimal  @db.Decimal(12, 2)
  freeFrom           Decimal? @db.Decimal(12, 2)
  estimatedHoursMin  Int?
  estimatedHoursMax  Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Stock & achats
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RELEASE
}

model InventoryMovement {
  id            String                @id @default(cuid())
  variantId     String
  type          InventoryMovementType
  quantityDelta Int
  referenceType String?               @db.VarChar(60)
  referenceId   String?               @db.VarChar(191)
  note          String?               @db.VarChar(500)
  createdById   String?
  createdAt     DateTime              @default(now())

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(160)
  contact   String?  @db.VarChar(160)
  phone     String?  @db.VarChar(32)
  email     String?  @db.VarChar(191)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  reference   String              @unique @db.VarChar(60)
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  total       Decimal             @default(0) @db.Decimal(12, 2)
  expectedAt  DateTime?
  receivedAt  DateTime?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier  Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]

  @@index([supplierId, status])
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  variantId       String
  quantity        Int
  unitCost        Decimal @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique @db.VarChar(60)
  description    String?    @db.VarChar(255)
  type           CouponType
  value          Decimal    @default(0) @db.Decimal(12, 2)
  minOrder       Decimal    @default(0) @db.Decimal(12, 2)
  maxDiscount    Decimal?   @db.Decimal(12, 2)
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?
  perUserLimit   Int?
  appliesTo      Json?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  userId         String?
  orderId        String
  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([userId])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ContentPage {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(191)
  title       String        @db.VarChar(191)
  body        String        @db.Text
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(160)
  subtitle  String?  @db.VarChar(255)
  imageUrl  String   @db.VarChar(500)
  linkUrl   String?  @db.VarChar(500)
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @db.VarChar(255)
  answer    String   @db.Text
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique @db.VarChar(191)
  consentedAt    DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Chat & notifications
// ---------------------------------------------------------------------------

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum ConversationRole {
  CUSTOMER
  ADMIN
}

enum SenderType {
  CUSTOMER
  ADMIN
  SYSTEM
}

model Conversation {
  id              String             @id @default(cuid())
  userId          String?
  guestToken      String?            @db.VarChar(191)
  orderId         String?
  assignedAdminId String?
  status          ConversationStatus @default(OPEN)
  lastMessageAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user          User?                    @relation("CustomerConversations", fields: [userId], references: [id], onDelete: SetNull)
  assignedAdmin User?                    @relation("AssignedAdminConversations", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  order         Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([status, lastMessageAt])
  @@index([userId])
  @@index([assignedAdminId])
  @@index([guestToken])
}

model ConversationParticipant {
  id             String           @id @default(cuid())
  conversationId String
  userId         String
  role           ConversationRole @default(CUSTOMER)
  joinedAt       DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String     @id @default(cuid())
  conversationId String
  senderId       String?
  senderType     SenderType @default(CUSTOMER)
  body           String     @db.Text
  attachments    Json?
  readAt         DateTime?
  createdAt      DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

enum NotificationType {
  ORDER_UPDATE
  PROMO
  CHAT
  BACK_IN_STOCK
  PRICE_DROP
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(191)
  body      String           @db.VarChar(500)
  data      Json?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model NotificationPreference {
  userId         String   @id
  orderUpdates   Boolean  @default(true)
  promotions     Boolean  @default(false)
  chat           Boolean  @default(true)
  pushEnabled    Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String    @id @default(cuid())
  userId    String?
  endpoint  String    @unique @db.VarChar(500)
  p256dh    String    @db.VarChar(255)
  auth      String    @db.VarChar(255)
  userAgent String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Administration & configuration
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(191)
  before     Json?
  after      Json?
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model Setting {
  key       String   @id @db.VarChar(191)
  value     Json
  updatedAt DateTime @updatedAt
}

model Announcement {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(120)
  body        String   @db.VarChar(500)
  url         String?  @db.VarChar(500)
  pushSuccess Int      @default(0)
  pushFailed  Int      @default(0)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}
